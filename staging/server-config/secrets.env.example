# /etc/stemapp/secrets.env
#
# Production secrets file. Copy this to /etc/stemapp/secrets.env on the
# server and fill in the real values. NEVER commit the populated file.
#
# Required permissions:
#   sudo mkdir -p /etc/stemapp
#   sudo cp secrets.env.example /etc/stemapp/secrets.env
#   sudo chown root:www-data /etc/stemapp/secrets.env
#   sudo chmod 640 /etc/stemapp/secrets.env
#
# After editing, restart php-fpm so PHP picks it up:
#   sudo systemctl restart php-fpm   # or php8.1-fpm, php7.4-fpm etc
#
# The loader reads this file directly via PHP file(); it does NOT need
# to be exported as shell env vars. Place outside the webroot.

openai_api_key=sk-REPLACE_WITH_NEW_KEY
deepseek_api_key=sk-REPLACE_WITH_NEW_KEY
