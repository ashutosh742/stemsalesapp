<?php
// stem_env_loader_20260617 -- DEPLOY-ONLY SNIPPET (not auto-included).
//
// WHY: The webroot index.php is NOT tracked in git (deploy-only, same as .env).
// The .env next to index.php holds STEM_OPENAI_KEY / STEM_ASK_LLM_API_KEY etc,
// but nothing loaded it into the process env, so getenv() returned empty and
// every getenv()-based LLM feature (Role-Play, Chat, AnayaAsk, Ask LLM, Probes)
// was silently keyless. This snippet is inserted into the live index.php
// immediately AFTER the line: ini_set('display_errors', 0);
//
// It is recorded here so git mirrors what is deployed on staging. Re-apply this
// block to index.php on any fresh deploy, then hit /_opc.php?k=r to reset cache.
//
// Defensive, ASCII only, never overwrites a var already set in the real server
// environment, never logs values. Does nothing when .env is absent.

(function () {
    $envPath = __DIR__ . '/.env';
    if (!is_file($envPath) || !is_readable($envPath)) { return; }
    $lines = @file($envPath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if ($lines === false) { return; }
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#') { continue; }
        $eq = strpos($line, '=');
        if ($eq === false) { continue; }
        $k = trim(substr($line, 0, $eq));
        $v = trim(substr($line, $eq + 1));
        if ($k === '' || strpos($k, '#') === 0) { continue; }
        $len = strlen($v);
        if ($len >= 2 && (($v[0] === '"' && $v[$len-1] === '"') || ($v[0] === "'" && $v[$len-1] === "'"))) {
            $v = substr($v, 1, $len - 2);
        }
        $existing = getenv($k);
        if ($existing === false || $existing === '') {
            putenv($k . '=' . $v);
            $_ENV[$k] = $v;
            $_SERVER[$k] = $v;
        }
    }
})();
